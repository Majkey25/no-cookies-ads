{
  "name": "no-cookies-ads",
  "version": "1.3.5",
  "private": true,
  "description": "Chrome MV3 protection against ads, trackers, third-party cookies, cookie banners, and annoyances.",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@adguard/agtree-runtime": "npm:@adguard/agtree@4.4.0",
    "@adguard/api-mv3": "2.0.1",
    "js-yaml": "file:vendor/js-yaml-compat",
    "js-yaml-modern": "npm:js-yaml@5.5.0"
  },
  "devDependencies": {
    "@adguard/dnr-rulesets": "4.1.20260823070052",
    "@adguard/tswebextension": "4.1.2",
    "archiver": "^8.0.0",
    "crypto-browserify": "^3.12.1",
    "playwright": "1.65.1",
    "stream-browserify": "^3.0.0",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.112.2"
  },
  "overrides": {
    "axios": "1.20.0",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.2",
    "pbkdf2": "3.1.7",
    "archiver": {
      "readdir-glob": "4.0.0"
    },
    "js-yaml": "$js-yaml"
  }
}
