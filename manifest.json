{
  "manifest_version": 3,
  "name": "No Cookies & Ads",
  "short_name": "No Cookies",
  "version": "1.0.4",
  "description": "Block ads, trackers, third-party cookies, cookie banners, popups, and browser annoyances.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "webRequest",
    "webNavigation",
    "unlimitedStorage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "No Cookies & Ads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "adguard-content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "web-accessible-resources/redirects/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
